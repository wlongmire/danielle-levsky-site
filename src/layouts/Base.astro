---
// Shared frame for every page: header with navigation, footer, and the contact popup.
// The palette and fonts come from src/styles/tokens.css. Navigation: About, then the section pages
// (src/content/sections, in the order set in src/data/order.json), then the Contact button.
import '../styles/tokens.css';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import logo from '../assets/logo-dl.png';
import ContactDialog from '../components/ContactDialog.astro';
import { site } from '../data/site';
import { sortByOrder } from '../lib/order';

interface Props { title?: string; description?: string; }
const { title, description } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const sections = sortByOrder(await getCollection('sections', (e) => !e.data.draft), 'sections');
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { label: 'About', href: '/about' },
  ...sections.map((s) => ({ label: s.data.navLabel, href: `/projects/${s.id}` })),
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body class="b">
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="bar wrap">
      <a class="brand" href="/" aria-label={`${site.name}, home`}>
        <Image src={logo} alt="" height={96} class="logo" loading="eager" />
        <span class="name">{site.name}</span>
      </a>
      <button type="button" class="menu-btn" aria-expanded="false" aria-controls="site-nav">
        <svg class="i-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
        <svg class="i-close" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
        <span class="menu-label">Menu</span>
      </button>
      <nav id="site-nav" class="site-nav" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a>)}
        <a class="btn" href={`mailto:${site.email}`} data-open-contact>Contact</a>
      </nav>
    </div>
  </header>

  <main id="main" class="wrap">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap foot">
      <p class="foot-name">{site.name}</p>
      <ul class="foot-links">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {site.links.filter((l) => l.url).map((l) => (
          <li><a href={l.url} rel="me noopener">{l.label}</a></li>
        ))}
      </ul>
      <p class="foot-copy">© {new Date().getFullYear()} {site.name}</p>
    </div>
  </footer>

  <ContactDialog />

  <script>
    // Phone menu: the Menu button opens and closes the links. Without JavaScript the links simply show.
    const header = document.querySelector<HTMLElement>('.site-header')!;
    const btn = header.querySelector<HTMLButtonElement>('.menu-btn')!;
    const label = btn.querySelector<HTMLElement>('.menu-label')!;
    const setOpen = (open: boolean) => {
      header.toggleAttribute('data-open', open);
      btn.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Close' : 'Menu';
    };
    btn.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
    header.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.hasAttribute('data-open')) { setOpen(false); btn.focus(); }
    });
    // Choosing Contact opens its popup, so close the menu behind it.
    header.querySelectorAll('[data-open-contact]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
    // Growing past the phone layout resets it.
    matchMedia('(min-width: 770px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
  </script>
</body>
</html>

<style is:global>
  html:has(dialog[open]) { overflow: hidden; scrollbar-gutter: stable; }
  html { scroll-padding-top: 96px; }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
  .b { margin: 0; overflow-x: clip; background: var(--bg-texture) var(--bg); color: var(--text); font: 400 17px/1.55 var(--font-body); }
  .b * { box-sizing: border-box; }
  .b .wrap { max-width: 1120px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 48px); }
  .b a { color: inherit; }
  .b a:focus-visible, .b button:focus-visible { outline: 3px solid var(--amber); outline-offset: 3px; }
  .b .skip { position: absolute; left: -999px; top: 8px; background: var(--amber); color: var(--on-amber); padding: 8px 12px; z-index: 200; }
  .b .skip:focus { left: 8px; }

  .b .site-header { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 92%, transparent); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-bottom: 1px solid var(--rule); }
  .b .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; padding-top: 14px; padding-bottom: 14px; }
  .b .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; margin-right: auto; }
  .b .logo { height: 48px; width: auto; display: block; }
  .b .name { font: 500 28px/1 var(--font-display); color: var(--amber); }
  @media (max-width: 480px) { .b .logo { height: 40px; } .b .name { font-size: 24px; } }
  .b .site-nav { display: flex; flex-wrap: wrap; align-items: center; gap: 0 22px; font-weight: 500; font-size: 16px; }
  .b .site-nav a:not(.btn) { text-decoration: none; padding: 10px 0; border-bottom: 2px solid transparent; }
  .b .site-nav a:not(.btn):hover { color: var(--amber); }
  /* The selected page's underline is drawn as a background, a few pixels under the text (a border would sit at the bottom of the link's padding, further away). */
  .b .site-nav a[aria-current] { color: var(--amber); background: linear-gradient(var(--amber), var(--amber)) 0 calc(100% - 6px) / 100% 2px no-repeat; }
  /* Contact and Menu share one look: the filled accent button. */
  .b .btn, .b .menu-btn { display: inline-flex; align-items: center; background: var(--amber); color: var(--on-amber); text-decoration: none; padding: 12px 22px; min-height: 44px; border-radius: 4px; font: 500 16px var(--font-body); }
  .b .btn:hover, .b .menu-btn:hover { filter: brightness(1.15); }
  .b .menu-btn { display: none; gap: 10px; padding: 12px 18px; border: 0; cursor: pointer; }
  .b .menu-btn svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .b .menu-btn .i-close, .b .menu-btn[aria-expanded='true'] .i-open { display: none; }
  .b .menu-btn[aria-expanded='true'] .i-close { display: block; }
  /* Phones and small tablets (under 770px). Without JavaScript the links wrap onto a second row under the name.
     With it, only the name and the Menu button show; Menu opens the links (and Contact) as a list below. */
  @media (max-width: 769px) {
    .b .site-nav { order: 3; width: 100%; }
    .b .site-header { position: static; }
    .js .site-header { position: sticky; }
    .js .menu-btn { display: inline-flex; }
    .js .site-nav { display: none; flex-direction: column; align-items: stretch; flex-wrap: nowrap; gap: 0; margin-top: 4px; padding-bottom: 16px; border-top: 1px solid var(--rule); max-height: calc(100svh - 100px); overflow-y: auto; font-size: 18px; }
    .js .site-header[data-open] .site-nav { display: flex; }
    .js .site-nav a:not(.btn) { display: flex; align-items: center; min-height: 52px; padding: 12px 4px; border-bottom: 1px solid var(--rule); }
    .js .site-nav a[aria-current] { background: none; border-bottom-color: var(--rule); box-shadow: inset 4px 0 0 var(--amber); padding-left: 16px; }
    .js .site-nav .btn { justify-content: center; margin-top: 16px; }
  }

  .b .section-title { font: 500 clamp(30px, 4vw, 42px)/1.15 var(--font-display); color: var(--amber); margin: 0 0 24px; }

  .b .site-footer { border-top: 1px solid var(--rule); }
  .b .foot { padding-top: 32px; padding-bottom: 40px; color: var(--muted); font-size: 15px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px 32px; }
  .b .foot-name { font: 500 24px var(--font-display); color: var(--amber); margin: 0 auto 0 0; }
  .b .foot-links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .b .foot a { text-underline-offset: 4px; }
  .b .foot a:hover { color: var(--amber); }
  .b .foot-copy { margin: 0; flex-basis: 100%; font-size: 13px; }
</style>
