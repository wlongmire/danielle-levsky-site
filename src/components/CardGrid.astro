---
// Page block: Card Grid. A titled grid of portfolio entries. "More info" opens that entry in the popup
// (CaseDialog, which must be on the same page) and puts its name in the address, e.g. /projects/ld-portfolio#baker-tilly.
// With groupBy="org" the cards sit under a heading for each position (the entry's `org`), in the order they are listed,
// each position in its own dark panel.
interface Props { title?: string; cases: { entry: any; Content: any }[]; groupBy?: 'org'; }
const { title, cases, groupBy } = Astro.props;
const roleLine = (d: any) => [d.role, !groupBy && d.org && !d.title.includes(d.org) ? d.org : '', d.dates].filter(Boolean).join(' · ');
// A card only gets a "More info" button when there is something to open.
const hasDetail = (e: any) => Boolean(e.body?.trim()) || e.data.media.length > 0 || e.data.images.length > 0 || e.data.artifacts.length > 0 || e.data.links.length > 0;

const groups: { heading?: string; items: typeof cases }[] = [];
for (const c of cases) {
  const heading = groupBy ? c.entry.data[groupBy] || undefined : undefined;
  const last = groups[groups.length - 1];
  if (last && last.heading === heading) last.items.push(c); else groups.push({ heading, items: [c] });
}
// Heading levels follow what is above them: a grid title is h2, a position heading under it h3 (h2 when there is no
// grid title), and the cards one level below whatever heading they sit under.
const GroupHeading = title ? 'h3' : 'h2';
const Heading = groupBy ? (title ? 'h4' : 'h3') : 'h3';
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
{cases.length > 0 && (
  <section class="cards" aria-labelledby={title ? 'cards-title' : undefined}>
    {title && <h2 id="cards-title" class="section-title">{title}</h2>}
    {groups.map((g) => (
      <div class:list={['group', { boxed: g.heading }]} role={g.heading ? 'group' : undefined} aria-labelledby={g.heading ? `grp-${slug(g.heading)}` : undefined}>
        {g.heading && <GroupHeading id={`grp-${slug(g.heading)}`} class="group-title">{g.heading}</GroupHeading>}
        <ul class="grid">
          {g.items.map(({ entry }) => (
            <li>
              <article class="card" id={entry.id}>
                <Heading class="card-title">{entry.data.title}</Heading>
                {roleLine(entry.data) && <p class="role">{roleLine(entry.data)}</p>}
                <p class="outcome">{entry.data.outcome}</p>
                {hasDetail(entry) && <button type="button" class="card-more" data-case={entry.id} aria-haspopup="dialog">More info</button>}
              </article>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
)}

<style>
  .cards { padding: 24px 0 72px; }
  .group + .group { margin-top: 28px; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .card { display: flex; flex-direction: column; height: 100%; background: var(--card); border: 1px solid var(--rule); border-radius: 8px; padding: 16px 18px; transition: border-color .2s, transform .2s; }
  .card:hover { border-color: var(--amber); transform: translateY(-2px); }
  /* The title is set in the sturdier body font and full-strength text colour so it reads first; the summary under it is a step quieter. */
  .card-title { font: 700 18px/1.3 var(--font-body); color: var(--text); margin: 0 0 4px; }
  .role { margin: 0 0 8px; color: var(--muted); font-size: 13px; }
  .outcome { margin: 0 0 14px; color: var(--muted); font-size: 14.5px; line-height: 1.5; }
  .card .outcome:last-child { margin-bottom: 0; }
  .card-more { margin-top: auto; align-self: flex-start; font: 600 14px var(--font-body); color: var(--amber); background: transparent; border: 1.5px solid var(--amber); border-radius: 6px; padding: 6px 14px; min-height: 40px; cursor: pointer; }
  .card-more:hover { background: var(--amber); color: var(--on-amber); }
  .card-more:focus-visible { outline: 3px solid var(--amber); outline-offset: 3px; }

  /* A position's cards sit in a dark panel: its heading, the cards and their buttons all switch to the dark-panel colours. */
  .boxed { background: var(--dark); border-radius: 16px; padding: clamp(16px, 3vw, 32px); }
  .group-title { margin: 0 0 18px; font: 500 clamp(28px, 3.4vw, 38px)/1.15 var(--font-display); color: var(--on-dark); }
  .boxed .card { background: var(--dark-card); border-color: var(--dark-rule); }
  .boxed .card:hover { border-color: var(--accent-on-dark); }
  .boxed .card-title { color: var(--on-dark); }
  .boxed .role, .boxed .outcome { color: var(--on-dark-muted); }
  .boxed .card-more { color: var(--accent-on-dark); border-color: var(--accent-on-dark); }
  .boxed .card-more:hover { background: var(--accent-on-dark); color: var(--dark); }
  .boxed .card-more:focus-visible { outline-color: var(--accent-on-dark); }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; } .card:hover { transform: none; } }
</style>
