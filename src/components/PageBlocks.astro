---
// Draws a page from its ordered `blocks:` list (home, about and each section page all use this). Each block type is one
// component: Hero, Overview List, Card Grid, Text. The project popup (CaseDialog) is added once for all the cards on the page.
import Hero from './Hero.astro';
import OverviewList from './OverviewList.astro';
import CardGrid from './CardGrid.astro';
import TextBlock from './TextBlock.astro';
import TitleBlock from './TitleBlock.astro';
import CaseDialog from './CaseDialog.astro';
import { loadPicks } from '../lib/cases';
import { CROPS, type Block } from '../lib/blocks';

interface Props { blocks: Block[]; }
const { blocks } = Astro.props;

// The entries behind every Card Grid block, loaded up front so one popup serves them all.
const casesFor = await Promise.all(
  blocks.map((b) => (b.type !== 'cards' ? [] : loadPicks(b.entries))),
);
const popupCases = [...new Map(casesFor.flat().map((c) => [c.entry.id, c])).values()];
// The first block with a headline holds the page's main title (h1); the rest step down to h2.
const firstTitled = blocks.findIndex((b) => b.type === 'hero' || (b.type === 'text' && b.title) || (b.type === 'title' && b.title));
---
{blocks.map((b, i) => {
  const uid = i === 0 ? '' : `-${i}`;
  switch (b.type) {
    case 'hero':
      return (
        <Hero
          headline={b.headline}
          intro={b.intro}
          buttons={b.buttons}
          image={b.image}
          imageAlt={b.imageAlt}
          imagePosition={b.imageCrop ? CROPS[b.imageCrop as keyof typeof CROPS].position : undefined}
          imageSlot={b.featured}
          large={b.featured}
          h1={i === firstTitled}
          uid={uid}
        />
      );
    case 'overview':
      return <OverviewList title={b.title} items={b.items} uid={uid} />;
    case 'cards':
      return <CardGrid title={b.title} cases={casesFor[i]} boxed={b.boxed} below={blocks.slice(0, i).some((x) => x.type === 'title')} uid={uid} />;
    case 'title':
      return <TitleBlock title={b.title} h1={i === firstTitled} uid={uid} />;
    case 'text':
      return <TextBlock title={b.title} body={b.body} photos={b.photos} h1={i === firstTitled} after={i > 0} />;
  }
})}
{popupCases.length > 0 && <CaseDialog cases={popupCases} />}
