---
// Page block: Hero. A headline, a paragraph, an optional picture and an optional button.
// A button whose url is "#contact" opens the contact popup instead of going to a page.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';
import logo from '../assets/logo-dl.png';

interface Props {
  headline: string;
  intro?: string;
  buttons?: { label: string; url: string }[]; // the first is the main button; the rest are quieter, outlined ones
  image?: ImageMetadata;
  imageAlt?: string;
  imageSlot?: boolean;   // show the logo mark where the picture will go, until there is one
  h1?: boolean;
  imagePosition?: string; // where a wide picture is cropped to inside the frame, e.g. "46% 30%"
  large?: boolean;       // taller, and wider than the page content on big screens (the home page)
  uid?: string;          // makes the title's id unique when a page has more than one of this block
}
const { headline, intro, buttons = [], image, imageAlt = '', imagePosition, imageSlot = false, h1 = true, large = false, uid = '' } = Astro.props;
const Tag = h1 ? 'h1' : 'h2';
// A picture much wider than tall (a logo, say) is shown whole instead of being cropped into the portrait frame.
const wide = !!image && image.width / image.height > 2.5;
const external = (url: string) => /^https?:\/\//.test(url);   // web addresses open in a new tab
const paragraphs = (intro ?? '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);   // a blank line in the text starts a new paragraph
---
<section class:list={['hero', { 'has-img': image || imageSlot, large }]} aria-labelledby={`hero-title${uid}`}>
  <div class="hero-text">
    <Tag id={`hero-title${uid}`}>{headline}</Tag>
    {paragraphs.map((p) => <p class="hero-intro">{p}</p>)}
    {buttons.length > 0 && (
      <div class="hero-actions">
        {buttons.map((b, n) => b.url === '#contact'
          ? <a class={n === 0 ? 'btn' : 'btn btn-secondary'} href={`mailto:${site.email}`} data-open-contact>{b.label}</a>
          : external(b.url)
            ? <a class={n === 0 ? 'btn' : 'btn btn-secondary'} href={b.url} target="_blank" rel="noopener noreferrer">{b.label}<span class="sr-only"> (opens in a new tab)</span></a>
            : <a class={n === 0 ? 'btn' : 'btn btn-secondary'} href={b.url}>{b.label}</a>)}
      </div>
    )}
  </div>
  {image ? (
    <div class:list={['hero-img', { wide }]} style={imagePosition ? `--img-pos: ${imagePosition}` : undefined}><Image src={image} alt={imageAlt} width={large ? 1200 : 900} loading="eager" /></div>
  ) : imageSlot ? (
    <div class="hero-img hero-img-empty" aria-hidden="true"><Image src={logo} alt="" width={600} /></div>
  ) : null}
</section>

<style>
  .hero { display: flex; flex-wrap: wrap; align-items: center; gap: 40px; padding: 72px 0 56px; }
  .hero-text { flex: 2 1 380px; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .hero h1, .hero h2 { margin: 0; font: 500 clamp(40px, 5.5vw, 68px)/1.05 var(--font-display); color: var(--amber); text-wrap: balance; max-width: 16em; }
  .hero-intro { margin: 0; font-size: 20px; line-height: 1.55; color: var(--muted); max-width: 40em; }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  /* The quieter button: an outline in the accent colour, so "See my projects" stays the main action. */
  .hero .btn.btn-secondary { background: transparent; color: var(--amber); border: 1.5px solid var(--amber); }
  .hero .btn.btn-secondary:hover { background: var(--amber); color: var(--on-amber); filter: none; }
  .hero .btn.btn-secondary:focus-visible { outline: 3px solid var(--amber); outline-offset: 3px; }
  /* --r is the big rounded corner; the picture is clipped to it. */
  .hero-img { --r: 40px; flex: 1 1 240px; min-width: 0; max-width: 360px; aspect-ratio: 4 / 5; }
  /* The photo is landscape; crop to the portrait frame around her face. Re-tune object-position if the photo changes. */
  .hero-img :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--img-pos, 57% 30%); display: block; border-radius: 4px var(--r) 4px 4px; background: var(--rule); }
  /* A wide picture (logo) keeps its own shape: shown whole, beside the text, and below it on phones. */
  .hero-img.wide { aspect-ratio: auto; }
  .hero-img.wide :global(img) { height: auto; object-fit: contain; border-radius: 6px; background: none; }
  /* Phones: the photo comes first, full width and a little wider than tall, so it shows on the first screen. */
  @media (max-width: 769px) {
    .hero { padding: 20px 0 40px; gap: 24px; }
    .hero-img { --r: 32px; order: -1; flex: 1 1 100%; max-width: none; aspect-ratio: 4 / 3; }
    .hero-img.wide { order: 0; flex: 1 1 240px; max-width: 360px; aspect-ratio: auto; }
  }
  /* Large (home page): the hero sits on a backing panel, which adds breathing room around the text and picture. */
  .hero.large { --skew: -1.5deg; position: relative; isolation: isolate; margin-top: 24px; padding: 28px clamp(26px, 5vw, 72px) 36px; }
  /* The panel is a rounded rectangle tilted a little, so its left and right sides lean; the content on top is not tilted. */
  .hero.large::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--card); border-radius: 16px; transform: skewX(var(--skew)); }
  /* Large (home page): more height and a bigger picture and headline; on wide screens it also runs
     wider than the page content, centred on it. Phones keep the compact layout above. */
  @media (min-width: 770px) {
    .hero.large { --skew: -4deg; padding-block: 104px 96px; gap: 64px; min-height: clamp(540px, 74svh, 760px); }
    .hero.large .hero-text { flex: 3 1 420px; gap: 28px; }
    .hero.large h1, .hero.large h2 { font-size: clamp(44px, 6vw, 84px); }
    .hero.large .hero-intro { font-size: 22px; }
    .hero.large .hero-img { flex: 1 1 320px; max-width: 480px; }
  }
  @media (min-width: 1300px) {
    .hero.large { width: 1200px; margin-left: calc((100% - 1200px) / 2); }
  }
  /* The placeholder (logo mark where a picture will go) is a plain clipped box. */
  .hero-img-empty { display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 4px var(--r) 4px 4px; background: var(--rule); }
  .hero-img-empty :global(img) { width: 70%; height: auto; object-fit: contain; border-radius: 0; background: none; }
</style>
