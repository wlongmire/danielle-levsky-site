---
// Home: drawn from the ordered blocks in src/content/pages/home.md.
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageBlocks from '../components/PageBlocks.astro';
import { pageDescription } from '../lib/blocks';

const home = (await getEntry('pages', 'home'))!;
---
<Base description={pageDescription(home.data)}>
  <PageBlocks blocks={home.data.blocks} />
</Base>
