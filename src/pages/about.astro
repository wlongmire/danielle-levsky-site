---
// About: drawn from the ordered blocks in src/content/pages/about.md.
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageBlocks from '../components/PageBlocks.astro';
import { pageDescription } from '../lib/blocks';

const about = (await getEntry('pages', 'about'))!;
---
<Base title={about.data.title} description={pageDescription(about.data)}>
  <PageBlocks blocks={about.data.blocks} />
</Base>
