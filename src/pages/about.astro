---
// About: the Free Text / Image block.
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

const about = await getEntry('pages', 'about');
const { Content } = await render(about!);
---
<Base title="About" description={about!.data.description}>
  <article class="about">
    <div class="about-text">
      <h1>{about!.data.title}</h1>
      <Content />
    </div>
    {about!.data.headshot && (
      <div class="about-img"><Image src={about!.data.headshot} alt={about!.data.headshotAlt ?? ''} width={900} loading="eager" /></div>
    )}
  </article>
</Base>

<style>
  .about { display: flex; flex-wrap: wrap; gap: 48px; padding: 72px 0 96px; }
  .about-text { flex: 2 1 420px; min-width: 0; max-width: 44em; }
  .about-text h1 { margin: 0 0 24px; font: 500 clamp(40px, 5vw, 60px)/1.05 var(--font-display); color: var(--amber); }
  .about-text :global(p) { margin: 0 0 1.1em; font-size: 18px; line-height: 1.65; }
  .about-text :global(p:first-of-type) { font: 500 clamp(24px, 3vw, 32px)/1.25 var(--font-display); color: var(--text); }
  .about-img { flex: 1 1 260px; max-width: 360px; align-self: flex-start; border-radius: 4px 40px 4px 4px; overflow: hidden; }
  .about-img :global(img) { width: 100%; aspect-ratio: 4 / 5; height: auto; object-fit: cover; object-position: 57% 30%; display: block; }
</style>
