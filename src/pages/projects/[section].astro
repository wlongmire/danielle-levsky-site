---
// One page per file in src/content/sections, drawn from its ordered blocks (Hero, Overview List, Card Grid, Text).
// Anything deeper than this page (a project's details) opens as a popup with its own URL, never a page.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageBlocks from '../../components/PageBlocks.astro';
import { pageDescription } from '../../lib/blocks';

export async function getStaticPaths() {
  const sections = await getCollection('sections', (e) => !e.data.draft);
  return sections.map((section) => ({ params: { section: section.id }, props: { section } }));
}

const { section } = Astro.props;
const d = section.data;
---
<Base title={d.navLabel} description={pageDescription(d)}>
  <PageBlocks blocks={d.blocks} />
</Base>
